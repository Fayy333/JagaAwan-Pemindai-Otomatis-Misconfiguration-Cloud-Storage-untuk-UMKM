# Salin file ini menjadi .env lalu isi nilainya
# JANGAN commit file .env ke repository

# Path ke Service Account Key JSON milikmu
# Contoh: keys/jagaawan-sa.json
GOOGLE_APPLICATION_CREDENTIALS=

# (Opsional) Kunci enkripsi Fernet dalam format base64
# Biarkan kosong agar kunci dibuat otomatis saat scan pertama
JAGAAWAN_KEY=
